{
  "name": "@kubed.io/cdn",
  "version": "0.0.5",
  "description": "A theme layer and web components for Grafana panels, loaded by URL from jsDelivr.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kubed-io/cdn.git"
  },
  "homepage": "https://github.com/kubed-io/cdn#readme",
  "bugs": "https://github.com/kubed-io/cdn/issues",
  "files": [
    "dist"
  ],
  "exports": {
    "./kd.js": {
      "types": "./dist/kd/index.d.ts",
      "default": "./dist/kd.js"
    },
    "./openapi.js": {
      "types": "./dist/openapi/index.d.ts",
      "default": "./dist/openapi.js"
    },
    "./k8s.js": {
      "types": "./dist/k8s/index.d.ts",
      "default": "./dist/k8s.js"
    },
    "./n8n.js": {
      "types": "./dist/n8n/index.d.ts",
      "default": "./dist/n8n.js"
    },
    "./kd.css": "./dist/kd.css",
    "./github.js": {
      "types": "./dist/github/index.d.ts",
      "default": "./dist/github.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "build:probe": "node scripts/probe.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "dompurify": "3.4.16",
    "highlight.js": "11.12.0",
    "lit": "3.3.3",
    "marked": "18.1.0"
  },
  "peerDependencies": {
    "@n8n/chat": "1.41.3"
  },
  "peerDependenciesMeta": {
    "@n8n/chat": {
      "optional": true
    }
  }
}
